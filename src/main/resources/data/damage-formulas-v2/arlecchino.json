    {
      "id": "arlecchinoC1",
      "name": "C1 · All Reprisals and Arrears, Mine to Bear...",
      "source": "Arlecchino · Constellation",
      "category": "constellation",
      "description": "Adds another 100% coefficient to Masque's current-Bond term and grants interruption resistance during Normal and Charged Attacks.",
      "ownershipRequirements": {
        "local:arlecchinoConstellation": 1
      },
      "requiresEffects": [
