                          },
                          {
                            "type": "constant",
                            "value": -1000
                          }
                        ]
                      },
                      {
                        "type": "constant",
                        "value": 0.01
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "recipient": "self",
      "statChanges": []
    },
    {
      "id": "balemoonAlone",
      "name": "The Balemoon Alone May Know",
      "source": "Arlecchino · Passive",
      "category": "passive",
      "description": "While in combat, grants 40% Pyro DMG Bonus and prevents healing except from Balemoon Rising.",
      "defaultEnabled": true,
