  "effects":[
    {"id":"masqueRedDeath","name":"Masque of the Red Death","source":"Arlecchino · Normal Attack","category":"talent","description":"At 30% or more Bond of Life, converts Normal, Charged, and Plunging Attacks to Pyro. Normal hits also add ATK × Masque scaling × current Bond percentage to Base DMG.","defaultEnabled":true,"activation":{"event":"bondOfLifeActive","conditions":[{"type":"inputAtLeast","input":"bondOfLifePercent","value":30}]}},
    {"id":"agonyRepaid","name":"Agony Alone May Be Repaid","source":"Arlecchino · Passive","category":"passive","description":"Defeated or matured Blood-Debt Directives grant a 130% Max HP Bond of Life, subject to the Skill's cap.","impact":"Resource setup; current Bond is controlled directly by the Bond slider.","defaultEnabled":true,"activation":{"event":"bloodDebtAbsorbed"}},
    {"id":"strengthDefend","name":"Strength Alone Can Defend","source":"Arlecchino · Passive","category":"passive","description":"For every 100 ATK above 1,000, grants 1% All Elemental and Physical RES, capped at 20%.","impact":"Incoming-damage resistance only; outgoing damage is unchanged.","defaultEnabled":true,"activation":{"event":"always"},"metrics":[{"label":"All RES gained","unit":"percentPoints","expression":{"type":"min","operands":[{"type":"constant","value":20},{"type":"max","operands":[{"type":"constant","value":0},{"type":"multiply","operands":[{"type":"add","operands":[{"type":"input","input":"attack"},{"type":"constant","value":-1000}]},{"type":"constant","value":0.01}]}]}]}}]},
    {"id":"balemoonAlone","name":"The Balemoon Alone May Know","source":"Arlecchino · Passive","category":"passive","description":"While in combat, grants 40% Pyro DMG Bonus and prevents healing except from Balemoon Rising.","defaultEnabled":true,"activation":{"event":"inCombat"},"formulaModifiers":[{"targets":{"elements":["Pyro"]},"damageBonus":{"expression":{"type":"constant","value":40}}}]},
    {"id":"arlecchinoC1","name":"C1 · All Reprisals and Arrears, Mine to Bear...","source":"Arlecchino · Constellation","category":"constellation","description":"Adds another 100% coefficient to Masque's current-Bond term and grants interruption resistance during Normal and Charged Attacks.","ownershipRequirements":{"arlecchinoConstellation":1},"requiresEffects":["masqueRedDeath"],"activation":{"event":"masqueActive"},"formulaModifiers":[{"targets":{"requiredTags":["masqueNormal"]},"base":{"type":"multiply","operands":[{"type":"input","input":"attack"},{"type":"input","input":"bondOfLifePercent"},{"type":"constant","value":0.01}]}},{"targets":{"formulaIds":["masque-normal-4"]},"base":{"type":"multiply","operands":[{"type":"input","input":"attack"},{"type":"input","input":"bondOfLifePercent"},{"type":"constant","value":0.01}]}}]},
