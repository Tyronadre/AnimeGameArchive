  "effects": [
    {
      "id": "masqueRedDeath",
      "name": "Masque of the Red Death",
      "source": "Arlecchino · Normal Attack",
      "category": "talent",
      "description": "At 30% or more Bond of Life, converts Normal, Charged, and Plunging Attacks to Pyro. Normal hits also add ATK × Masque scaling × current Bond percentage to Base DMG.",
      "defaultEnabled": true,
      "activation": {
        "event": "bondOfLifeActive",
        "conditions": [
          {
            "type": "inputAtLeast",
            "input": "local:bondOfLifePercent",
            "value": 30
          }
        ]
      },
      "recipient": "self",
      "statChanges": []
    },
    {
      "id": "agonyRepaid",
      "name": "Agony Alone May Be Repaid",
      "source": "Arlecchino · Passive",
      "category": "passive",
      "description": "Defeated or matured Blood-Debt Directives grant a 130% Max HP Bond of Life, subject to the Skill's cap.",
      "impact": "Resource setup; current Bond is controlled directly by the Bond slider.",
      "defaultEnabled": true,
      "activation": {
        "event": "bloodDebtAbsorbed"
      },
      "recipient": "self",
      "statChanges": []
    },
    {
      "id": "strengthDefend",
      "name": "Strength Alone Can Defend",
      "source": "Arlecchino · Passive",
      "category": "passive",
      "description": "For every 100 ATK above 1,000, grants 1% All Elemental and Physical RES, capped at 20%.",
      "impact": "Incoming-damage resistance only; outgoing damage is unchanged.",
      "defaultEnabled": true,
      "activation": {
        "event": "always"
      },
      "metrics": [
        {
          "label": "All RES gained",
          "unit": "percentPoints",
